+    private PendingIntent buildOpenActivityIntent(ClickableView clickableView) {
+        String action = clickableView.getClickAction();
+        Intent activityIntent = null;
+        if ("OPEN_APP".equals(action)) {
+            activityIntent = appContext.getPackageManager().getLaunchIntentForPackage(appContext.getPackageName());
+        } else if ("OPEN_URI".equals(action)) {
+            ReadableMap data = clickableView.getClickActionData();
+            if (data != null && data.hasKey("uri")) {
+                activityIntent = new Intent(Intent.ACTION_VIEW, Uri.parse(data.getString("uri")));
+                activityIntent.setPackage(appContext.getPackageName());
+            }
+        }
+        if (activityIntent == null) {
+            return null;
+        }
+        activityIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        return PendingIntent.getActivity(
+            appContext,
+            activityIntent.filterHashCode(),
+            activityIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
+        );
+    }
